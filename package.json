{
  "name": "audit-ci",
  "version": "8.0.0-beta.1",
  "description": "Audits NPM, Yarn, and PNPM projects in CI environments",
  "keywords": [
    "actions",
    "advisory",
    "audit",
    "ci",
    "github",
    "github-actions",
    "npm",
    "pnpm",
    "security",
    "yarn"
  ],
  "homepage": "https://github.com/IBM/audit-ci",
  "bugs": "https://github.com/IBM/audit-ci/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:IBM/audit-ci.git"
  },
  "bin": "./dist/bin.js",
  "files": [
    "dist/*",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "tag": "next"
  },
  "scripts": {
    "check": "oxlint . && oxfmt .",
    "check:ci": "oxlint . --deny-warnings && oxfmt . --check",
    "tsc": "tsc -p tsconfig.build.json",
    "build": "node scripts/build.mjs",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "check-types": "tsc -p tsconfig.json",
    "schema": "ts-json-schema-generator -p ./docs/schema.d.ts -o ./docs/schema.json -t Schema",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@types/node": "*",
    "audit-types": "^0.7.0",
    "cross-spawn": "^7.0.6",
    "escape-string-regexp": "^4.0.0",
    "event-stream": "4.0.1",
    "jju": "^1.4.0",
    "jsonstream-next": "^3.0.0",
    "readline-transform": "1.0.0",
    "semver": "^7.8.6",
    "tslib": "^2.0.0",
    "yargs": "^17.0.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/event-stream": "^4.0.5",
    "@types/jju": "^1.4.5",
    "@types/jsonstream-next": "^3.0.3",
    "@types/readline-transform": "^1.0.5",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
